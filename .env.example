# Required env vars for the Nekter event site (set on Vercel project)

# Resend API key — sends the confirmation email.
# Generate at https://resend.com/api-keys for the admin@nekter.ai account.
RESEND_API_KEY=

# CRM intake endpoint + shared secret. The /api/register function posts
# every webinar signup here so the lead lands in NekterCRM.
CRM_INTAKE_URL=https://crm.nekter.ai/api/intake
CRM_INTAKE_SECRET=
